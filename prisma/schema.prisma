generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────────────
// Tablas existentes (extendidas con nuevos campos)
// ──────────────────────────────────────────────────────

model Record {
  id       String  @id
  type     String  // "activo" | "pasivo" | "ingreso" | "gasto"
  name     String
  amount   Decimal @db.Decimal
  currency String
  linkedTo String? @map("linked_to")

  // Nuevos campos — nullable para compatibilidad con datos existentes
  userId            String?   @map("user_id")
  description       String?
  operationDate     DateTime? @map("operation_date")
  deletedAt         DateTime? @map("deleted_at")
  status            String    @default("ACTIVE") // "ACTIVE" | "PENDING" | "CANCELLED" | "HISTORICAL" | "ARCHIVED"
  // Desde v2.5.0 es una ETIQUETA: guarda el id de una AssetCategory.
  // Los valores legados (STOCK, BOND, ...) resuelven contra categorías sembradas
  // con ese mismo id, así que no hizo falta migrar los registros.
  assetType         String?   @map("asset_type")
  // Capacidad: el activo se opera en unidades (cantidad + precio promedio)
  tracksQuantity    Boolean   @default(false) @map("tracks_quantity")
  ticker            String?
  currentQty        Decimal?  @map("current_quantity")    @db.Decimal(18, 8)
  avgBuyPrice       Decimal?  @map("avg_buy_price")       @db.Decimal(18, 4)
  parentId          String?   @map("parent_id")
  metadata          Json?
  createdAt         DateTime  @default(now())              @map("created_at")
  effectiveDate     DateTime?                              @map("effective_date")
  previousVersionId String?                               @map("previous_version_id")

  user               User?               @relation(fields: [userId], references: [id])
  groups             RecordGroup[]
  financialMovements FinancialMovement[]
  auditLogs          AuditLog[]
  incomeRules        IncomeRule[]
  incomeOccurrences  IncomeOccurrence[]
  parent             Record?             @relation("RecordChildren", fields: [parentId], references: [id])
  children           Record[]            @relation("RecordChildren")
  previousVersion    Record?             @relation("RecordVersions", fields: [previousVersionId], references: [id])
  nextVersions       Record[]            @relation("RecordVersions")
  gastoLinks         GastoIngresoLink[]  @relation("GastoLinks")
  ingresoLinks       GastoIngresoLink[]  @relation("IngresoLinks")

  @@map("records")
  @@index([userId])
  @@index([userId, type])
}

model Snapshot {
  id        String @id
  name      String
  period    String          // legacy: texto libre o "DD/MM/YYYY - DD/MM/YYYY"
  createdAt String @map("created_at") // legacy: string formateado en español

  // Nuevos campos
  userId    String?   @map("user_id")
  startDate DateTime? @map("start_date")
  endDate   DateTime? @map("end_date")
  data      Json?     // jsonb: estado consolidado (Fase 4)

  user            User?            @relation(fields: [userId], references: [id])
  snapshotRecords SnapshotRecord[]

  @@map("snapshots")
  @@index([userId])
}

model SnapshotRecord {
  id         String  @id
  snapshotId String  @map("snapshot_id")
  type       String
  name       String
  amount     Decimal @db.Decimal
  currency   String
  linkedTo   String? @map("linked_to")

  snapshot Snapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@map("snapshot_records")
  @@index([snapshotId])
}

model AuditLog {
  id         String @id
  date       String
  action     String // "creado" | "editado" | "eliminado"
  recordType String @map("record_type")
  recordName String @map("record_name")
  detail     String
  comment    String @default("")

  // Nuevos campos
  userId    String?  @map("user_id")
  recordId  String?  @map("record_id")
  createdAt DateTime @default(now()) @map("created_at")

  user   User?   @relation(fields: [userId], references: [id])
  record Record? @relation(fields: [recordId], references: [id])

  @@map("movements")
  @@index([userId])
  @@index([userId, createdAt])
}

// ──────────────────────────────────────────────────────
// Tablas nuevas
// ──────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt      @map("updated_at")

  // Día del mes (1-28) en que corresponde el corte mensual
  cutoffDay Int @default(1) @map("cutoff_day")

  records            Record[]
  groups             Group[]
  snapshots          Snapshot[]
  financialMovements FinancialMovement[]
  auditLogs          AuditLog[]
  obligations        Obligation[]
  obligationPayments ObligationPayment[]
  journalEntries     JournalEntry[]
  gastoIngresoLinks  GastoIngresoLink[]
  markers            Marker[]
  entityMarkers      EntityMarker[]
  monthlyCutoffs     MonthlyCutoff[]
  incomeRules        IncomeRule[]
  incomeOccurrences  IncomeOccurrence[]
  assetCategories    AssetCategory[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

// Recuperación de contraseña. Ver PRODUCT_REVIEW.md §3.4 — antes no existía
// ningún camino de vuelta si te olvidabas la contraseña.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Etiqueta libre de activos. Reemplaza al enum AssetType: desde v2.5.0 la
/// categoría no determina ningún comportamiento, solo agrupa visualmente.
model AssetCategory {
  id        String   @id
  userId    String   @map("user_id")
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, name])
  @@map("asset_categories")
  @@index([userId])
}

// ── Módulo: Flujos de Ingresos ────────────────────────────────────────────────
// Espejo de ObligationRule / ObligationPayment, colgando de un Record type="activo".

model IncomeRule {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  recordId       String   @map("record_id")
  name           String
  recurrenceType String   @map("recurrence_type") // "MONTHLY" | "QUARTERLY" | "SEMI_ANNUAL" | "ANNUAL"
  startDate      DateTime @map("start_date")
  expectedAmount Decimal  @db.Decimal(18, 4) @map("expected_amount")
  currency       String
  status         String   @default("ACTIVE") // "ACTIVE" | "PAUSED" | "COMPLETED"
  // true = el cobro descuenta del capital del activo (cuota de préstamo)
  // false = el cobro es renta pura (sueldo, interés, alquiler)
  reducesPrincipal Boolean @default(false) @map("reduces_principal")

  // Cómo se determina el monto de cada ocurrencia
  amountMode String   @default("FIXED") @map("amount_mode") // "FIXED" | "PERCENTAGE"
  // Solo con amountMode="PERCENTAGE": % sobre el valor del activo al generar la ocurrencia
  percentage Decimal? @db.Decimal(9, 4)
  // Solo con amountMode="FIXED": ajuste compuesto de adjustmentPct cada adjustEveryN ocurrencias
  adjustmentPct Decimal? @db.Decimal(9, 4) @map("adjustment_pct")
  adjustEveryN  Int?     @map("adjust_every_n")

  // "CASH" = entra efectivo | "IN_KIND" = entra más cantidad del propio activo (staking)
  settlement String @default("CASH")

  // null = recurrente indefinido | N = cronograma finito de N cuotas
  installmentCount Int? @map("installment_count")

  createdAt      DateTime @default(now()) @map("created_at")
  metadata       Json?

  user        User               @relation(fields: [userId], references: [id])
  record      Record             @relation(fields: [recordId], references: [id], onDelete: Cascade)
  occurrences IncomeOccurrence[]

  @@map("income_rules")
  @@index([userId])
  @@index([recordId])
}

model IncomeOccurrence {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  ruleId          String   @map("rule_id")
  recordId        String   @map("record_id")
  expectedDate    DateTime @map("expected_date")
  expectedAmount  Decimal  @db.Decimal(18, 4) @map("expected_amount")
  actualAmount    Decimal? @db.Decimal(18, 4) @map("actual_amount")
  currency        String
  status          String   @default("PENDING") // "PENDING" | "COLLECTED" | "REJECTED"
  ingresoRecordId String?  @map("ingreso_record_id")
  comment         String?
  // Número de cuota (1..N) cuando la regla tiene cronograma finito
  installmentNumber Int? @map("installment_number")
  // Unidades recibidas cuando settlement="IN_KIND"
  quantity Decimal? @db.Decimal(18, 8)
  createdAt       DateTime @default(now()) @map("created_at")

  user   User       @relation(fields: [userId], references: [id])
  rule   IncomeRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  record Record     @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@map("income_occurrences")
  @@index([ruleId])
  @@index([recordId])
  @@index([userId, expectedDate])
  @@index([userId, status])
}

// ── Módulo: Corte Mensual ─────────────────────────────────────────────────────

model MonthlyCutoff {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  period     String   // "YYYY-MM" del período cerrado
  cutoffDay  Int      @map("cutoff_day")
  executedAt DateTime @default(now()) @map("executed_at")

  // Opciones elegidas en el diálogo
  keptMarked           Boolean @default(false) @map("kept_marked")
  clearedEntityMarkers Boolean @default(false) @map("cleared_entity_markers")
  snapshotId           String? @map("snapshot_id")

  // Contadores del impacto
  gastosArchived    Int @default(0) @map("gastos_archived")
  ingresosArchived  Int @default(0) @map("ingresos_archived")
  recordsKept       Int @default(0) @map("records_kept")
  gastosGenerated   Int @default(0) @map("gastos_generated")
  ingresosGenerated Int @default(0) @map("ingresos_generated")
  markersCleared    Int @default(0) @map("markers_cleared")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, period])
  @@map("monthly_cutoffs")
  @@index([userId, executedAt])
}

// ── Libro Contable (Doble Entrada) ────────────────────────────────────────────

// AccountType values: "activos" | "pasivos" | "ingresos" | "gastos" | "efectivo" | "obligaciones"
model JournalEntry {
  id             String   @id @default(uuid())
  date           DateTime @default(now())
  description    String
  currency       String
  amount         Decimal  @db.Decimal(18, 4)
  debitAccount   String   @map("debit_account")
  creditAccount  String   @map("credit_account")
  sourceEntityId String?  @map("source_entity_id")
  targetEntityId String?  @map("target_entity_id")
  reference      String?
  notes          String?
  userId         String   @map("user_id")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, date])
  @@map("journal_entries")
}

// ── Módulo Obligaciones ────────────────────────────────────────────────────────

model Obligation {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  obligationType String    @map("obligation_type") // "RECURRING" | "INSTALLMENT" | "FIXED"
  name           String
  description    String?
  currency       String
  amount         Decimal   @db.Decimal(18, 4)
  status         String    @default("ACTIVE")     // "ACTIVE" | "PAUSED" | "COMPLETED" | "CANCELLED"
  nextDueDate    DateTime? @map("next_due_date")
  createdAt      DateTime  @default(now()) @map("created_at")
  metadata       Json?

  user         User                    @relation(fields: [userId], references: [id])
  rules        ObligationRule[]
  installments ObligationInstallment[]
  payments     ObligationPayment[]

  @@map("obligations")
  @@index([userId, status])
  @@index([userId, nextDueDate])
}

model ObligationRule {
  id             String   @id @default(uuid())
  obligationId   String   @map("obligation_id")
  name           String
  recurrenceType String   @map("recurrence_type") // "MONTHLY" | "QUARTERLY" | "SEMI_ANNUAL" | "ANNUAL"
  startDate      DateTime @map("start_date")
  expectedAmount Decimal  @db.Decimal(18, 4) @map("expected_amount")
  currency       String
  status         String   @default("ACTIVE") // "ACTIVE" | "PAUSED"
  metadata       Json?

  obligation Obligation @relation(fields: [obligationId], references: [id], onDelete: Cascade)

  @@map("obligation_rules")
  @@index([obligationId])
}

model ObligationInstallment {
  id                String   @id @default(uuid())
  obligationId      String   @map("obligation_id")
  installmentNumber Int      @map("installment_number")
  dueDate           DateTime @map("due_date")
  expectedAmount    Decimal  @db.Decimal(18, 4) @map("expected_amount")
  status            String   @default("PENDING") // "PENDING" | "OVERDUE" | "PAID" | "REJECTED"
  gastoRecordId     String?  @map("gasto_record_id")

  obligation Obligation @relation(fields: [obligationId], references: [id], onDelete: Cascade)

  @@map("obligation_installments")
  @@index([obligationId])
  @@index([dueDate, status])
}

model ObligationPayment {
  id             String    @id @default(uuid())
  obligationId   String    @map("obligation_id")
  userId         String    @map("user_id")
  ruleId         String?   @map("rule_id")
  paymentType    String    @map("payment_type") // "PAYMENT" | "INTEREST" | "FEE"
  expectedDate   DateTime? @map("expected_date")
  expectedAmount Decimal?  @db.Decimal(18, 4) @map("expected_amount")
  currency       String
  gastoRecordId  String?   @map("gasto_record_id")
  status         String                          // "PENDING" | "PAID" | "REJECTED"
  comment        String?
  createdAt      DateTime  @default(now()) @map("created_at")

  obligation Obligation @relation(fields: [obligationId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id])

  @@map("obligation_payments")
  @@index([obligationId])
  @@index([userId, expectedDate])
  @@index([ruleId])
}

model FinancialMovement {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  recordId      String   @map("record_id")
  movementType  String   @map("movement_type") // BUY | SELL | DIVIDEND | FEE | etc.
  amount        Decimal  @db.Decimal(18, 4)
  quantity      Decimal? @db.Decimal(18, 8)
  unitPrice     Decimal? @map("unit_price")    @db.Decimal(18, 4)
  currency      String
  exchangeRate  Decimal? @map("exchange_rate") @db.Decimal(18, 6)
  description   String?
  operationDate DateTime @map("operation_date") @default(now())
  createdAt     DateTime @default(now())        @map("created_at")
  metadata      Json?

  user   User   @relation(fields: [userId], references: [id])
  record Record @relation(fields: [recordId], references: [id])

  @@map("financial_movements")
  @@index([userId, operationDate])
  @@index([recordId])
}

model Group {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  groupType String   @map("group_type") // ASSET | INCOME | EXPENSE | LIABILITY
  createdAt DateTime @default(now()) @map("created_at")

  user    User          @relation(fields: [userId], references: [id])
  records RecordGroup[]

  @@map("groups")
}

model RecordGroup {
  recordId String @map("record_id")
  groupId  String @map("group_id")

  record Record @relation(fields: [recordId], references: [id], onDelete: Cascade)
  group  Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([recordId, groupId])
  @@map("record_groups")
}

// ── Módulo: Links Gasto↔Ingreso (N:M) ────────────────────────────────────────

model GastoIngresoLink {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  gastoId          String   @map("gasto_id")
  ingresoId        String   @map("ingreso_id")
  attributedAmount Decimal  @db.Decimal(18, 4) @map("attributed_amount")
  currency         String
  createdAt        DateTime @default(now()) @map("created_at")

  user    User   @relation(fields: [userId], references: [id])
  gasto   Record @relation("GastoLinks",   fields: [gastoId],   references: [id])
  ingreso Record @relation("IngresoLinks", fields: [ingresoId], references: [id])

  @@unique([gastoId, ingresoId])
  @@map("gasto_ingreso_links")
  @@index([userId])
  @@index([gastoId])
  @@index([ingresoId])
}

// ── Módulo: Marcadores Visuales ───────────────────────────────────────────────

model Marker {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  color     String   // hex color: "#EF4444"
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  user          User           @relation(fields: [userId], references: [id])
  entityMarkers EntityMarker[]

  @@map("markers")
  @@index([userId])
}

model EntityMarker {
  id         String   @id @default(uuid())
  markerId   String   @map("marker_id")
  entityId   String   @map("entity_id")   // record.id or obligation.id
  entityType String   @map("entity_type") // "RECORD" | "OBLIGATION"
  userId     String   @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at")

  marker Marker @relation(fields: [markerId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@unique([entityId, entityType])
  @@map("entity_markers")
  @@index([userId])
  @@index([entityId, entityType])
}
